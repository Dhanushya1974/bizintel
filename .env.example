# Copy to .env and adjust. Used by docker-compose.
# NEVER put real secrets in this file — it is tracked in git. Put them in .env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=bizintel
MYSQL_USER=bizintel
MYSQL_PASSWORD=bizintelpass
MYSQL_PORT=3306

# --- Backend (Node) ---
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- AI consultant (optional) ---
# Set ONE to enable a real LLM; otherwise the backend uses a data-grounded heuristic.
# OpenAI-compatible (OpenAI or OpenRouter):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1  +  OPENAI_MODEL=google/gemma-3-27b-it:free
# or Anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Frontend (TanStack Start SSR) ---
FRONTEND_PORT=3000
# Baked into the client bundle at build time.
VITE_API_URL=http://localhost:4000
