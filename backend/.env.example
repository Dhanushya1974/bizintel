# Backend service configuration
PORT=4000
# Comma-separated allowed origins for the browser app.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:8081

# MySQL connection (matches docker-compose service name "mysql")
DB_HOST=mysql
DB_PORT=3306
DB_USER=bizintel
DB_PASSWORD=bizintelpass
DB_NAME=bizintel

# --- AI consultant --------------------------------------------------------
# Set ONE of the following to enable a real LLM. If neither is set, the
# consultant answers from a data-grounded heuristic (still works, no key needed).
#
# OpenAI-compatible (OpenAI, OpenRouter, local gateways, ...):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
#   OpenRouter example:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=google/gemma-3-27b-it:free
#
# or Anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

LLM_MAX_TOKENS=900
